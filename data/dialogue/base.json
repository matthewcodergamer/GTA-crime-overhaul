{
  "schemaVersion": 2,
  "schema": "schema.json",
  "eventRegistry": "events.json",
  "packs": [
    "clerks.json",
    "civilians.json",
    "witnesses.json",
    "police.json",
    "guards.json",
    "hostages.json",
    "fallbacks.json"
  ],
  "selectionPolicy": {
    "weightedRandom": true,
    "respectConditions": true,
    "lineCooldowns": true,
    "sessionMax": true,
    "noRepeatGroup": true,
    "reuseGroupPenalty": 0.2,
    "recentLinePenalty": 0.15,
    "silenceAllowed": true
  },
  "audioPolicy": {
    "ambientSpeechMappingStatus": "not_validated",
    "voicePackStatus": "not_validated",
    "requireValidatedAssetBeforeNonNullReference": true
  }
}
