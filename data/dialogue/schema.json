{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matthewcodergamer/GTA-crime-overhaul/data/dialogue/schema.json",
  "title": "GTA Crime Overhaul Dialogue Pack",
  "type": "object",
  "required": ["schemaVersion", "packId", "speakerGroups", "fallbackEvent", "lines"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "packId": { "type": "string", "minLength": 1 },
    "speakerGroups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fallbackEvent": { "type": "string", "minLength": 1 },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "event", "speakerArchetypes", "intensity", "weight", "cooldownSeconds", "sessionMax", "reuseGroup", "noRepeatGroup", "conditions", "tags", "delivery"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "event": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "speakerArchetypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "intensity": { "type": "integer", "minimum": 0, "maximum": 5 },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "cooldownSeconds": { "type": "integer", "minimum": 0 },
          "sessionMax": { "type": ["integer", "null"], "minimum": 1 },
          "reuseGroup": { "type": "string", "minLength": 1 },
          "noRepeatGroup": { "type": "string", "minLength": 1 },
          "conditions": {
            "type": "object",
            "required": ["all", "any", "none"],
            "properties": {
              "all": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "any": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "none": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "persona": {
            "type": "object",
            "required": ["ageBands", "voiceGenders", "speechRegisters", "styleTags"],
            "properties": {
              "ageBands": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["young_adult", "adult", "older_adult", "any"] }
              },
              "voiceGenders": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["masculine", "feminine", "any"] }
              },
              "speechRegisters": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["grounded_contemporary", "neutral_professional", "measured", "any"] }
              },
              "styleTags": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          },
          "delivery": {
            "type": "object",
            "required": ["type", "text", "ambientSpeech", "voiceAsset"],
            "properties": {
              "type": { "enum": ["subtitle", "silent"] },
              "text": { "type": ["string", "null"] },
              "ambientSpeech": { "type": ["string", "null"] },
              "voiceAsset": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
